<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/title_container"
            android:background="@color/a66_title_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <Button
                android:id="@+id/menu_btn"
                android:background="@drawable/btn_menu_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.sengled.pulsea66.view.ThTextView
                android:textColor="@color/a66_text_plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/light"
                android:layout_centerInParent="true"
                style="@style/a66_title"/>
            <Button
                android:id="@+id/timing_onOff"
                android:background="@mipmap/icon_timing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/rgb_background"
            android:scaleType="fitXY"
            android:layout_below="@+id/title_container"/>
        <ImageView
            android:id="@+id/rgb_logo"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:src="@mipmap/rgb_logo"
            android:layout_below="@+id/title_container"
            android:layout_centerHorizontal="true"/>
        <com.sengled.pulsea66.view.ColorPickerView
            android:id="@+id/colorPickerView"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/rgb_logo"
            android:layout_centerHorizontal="true"
            fresco:src="@drawable/palette"
            fresco:selector="@drawable/wheel"
            fresco:onOff="@drawable/slelector_onoff"
            fresco:src_off="@drawable/palette_off"/>
        <RelativeLayout
            android:id="@+id/deviceCountLinear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/title_container">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_centerInParent="true"
                fresco:placeholderImage="@color/viewfinder_mask"
                fresco:placeholderImageScaleType="centerCrop"
                fresco:actualImageScaleType="centerCrop"
                fresco:roundAsCircle="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/icon_bulb"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#ea2839"
                    android:layout_gravity="center"
                    android:id="@+id/deviceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/brigthnessLinear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/colorPickerView">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="5dp"
                android:src="@mipmap/brightness_sub"/>
            <SeekBar
                android:layout_gravity="center"
                android:id="@+id/brightness_control"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="6dp"
                android:progressDrawable="@drawable/rgb_brightseek"
                android:minHeight="6dp"
                android:thumb="@mipmap/thumb_rgb"
                android:layout_weight="1"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="5dp"
                android:src="@mipmap/brightness_add"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.MultiRadioGroup2
            android:orientation="horizontal"
            android:id="@+id/mode_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/brigthnessLinear">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:textSize="12sp"
                    android:textColor="@color/selector_modetext"
                    android:gravity="center"
                    android:id="@+id/rb_relax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/mode_relax"
                    android:singleLine="true"
                    android:drawableTop="@drawable/selector_mode_relax"
                    android:drawablePadding="3dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:textSize="12sp"
                    android:textColor="@color/selector_modetext"
                    android:gravity="center"
                    android:id="@+id/rb_infusepower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/mode_infusepower"
                    android:singleLine="true"
                    android:drawableTop="@drawable/selector_mode_infusepower"
                    android:drawablePadding="3dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:textSize="12sp"
                    android:textColor="@color/selector_modetext"
                    android:gravity="center"
                    android:id="@+id/rb_happiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/mode_happiness"
                    android:singleLine="true"
                    android:drawableTop="@drawable/selector_mode_happiness"
                    android:drawablePadding="3dp"/>
            </LinearLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:textSize="12sp"
                    android:textColor="@color/selector_modetext"
                    android:gravity="center"
                    android:id="@+id/rb_romantice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/mode_romanticnight"
                    android:singleLine="true"
                    android:drawableTop="@drawable/selector_mode_romanticnight"
                    android:drawablePadding="3dp"/>
                <ImageView
                    android:id="@+id/romanticeMode_edit"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="8dp"
                    android:src="@mipmap/icon_modeedit"
                    android:layout_alignParentRight="true"/>
                <View
                    android:id="@+id/romantic_Linear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/rb_romantice"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RadioButton
                    android:textSize="12sp"
                    android:textColor="@color/selector_modetext"
                    android:gravity="center"
                    android:id="@+id/rb_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/mode_colors"
                    android:singleLine="true"
                    android:drawableTop="@drawable/selector_mode_colors"
                    android:drawablePadding="3dp"/>
                <ImageView
                    android:id="@+id/colorsMode_edit"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="8dp"
                    android:src="@mipmap/icon_modeedit"
                    android:layout_alignParentRight="true"/>
                <View
                    android:id="@+id/colors_Linear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/rb_colors"/>
            </RelativeLayout>
        </com.sengled.pulsea66.view.MultiRadioGroup2>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/mode_linear"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/vol_sub"
                    android:clickable="true"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:src="@drawable/rgb_vol_sub"
                    android:layout_alignParentBottom="true"/>
                <View
                    android:id="@+id/view_trans"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_toRightOf="@+id/vol_sub"/>
                <ImageView
                    android:id="@+id/vol_add"
                    android:clickable="true"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:src="@drawable/rgb_vol_add"
                    android:layout_toRightOf="@+id/view_trans"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
