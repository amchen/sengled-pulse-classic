<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feed_back"
            android:layout_centerInParent="true"
            style="@style/app_title"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_back"
            android:background="@drawable/back_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_context"
        android:background="@drawable/cloud_edit_text_bg_gray"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/rl_title">
        <com.sengled.cloud.ui.view.ThEditText
            android:textSize="@dimen/content_size"
            android:textColor="@color/text_plain_gray_deep"
            android:textColorHint="@color/text_plain_gray_low"
            android:gravity="top"
            android:id="@+id/et_feedcontent"
            android:background="@null"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:hint="@string/input_feedback"
            android:maxLength="500"/>
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/white_text"
            android:gravity="center"
            android:id="@+id/tv_write_number"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginRight="20dp"
            android:text="(0/500)"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <com.sengled.cloud.ui.view.ThButton
        android:gravity="center"
        android:id="@+id/bt_send"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:text="@string/bt_submit"
        android:layout_below="@+id/rl_context"
        style="@style/ActivityBtn"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_feedlist"
        android:background="@drawable/cloud_tips_btn_bg_red"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/bt_send">
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/text_plain_gray_deep"
            android:id="@+id/tv_feedname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="@string/query_back"/>
        <ImageView
            android:id="@+id/iv_icon_feed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/cloud_feed_icon_right"/>
    </LinearLayout>
    <com.sengled.cloud.ui.view.PullToRefreshListView
        android:id="@+id/lv_pull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="7dp"
        android:layout_marginRight="20dp"
        android:listSelector="#00000000"
        android:divider="@android:color/transparent"
        android:dividerHeight="5dp"
        android:layout_below="@+id/ll_feedlist"
        android:layout_alignLeft="@+id/ll_feedlist"/>
    <RelativeLayout
        android:id="@+id/rl_nomessage"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_feedlist">
        <ImageView
            android:id="@+id/iv_nomessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/cloud_icon_nomeessage"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/content_size"
                android:textColor="@color/text_plain_gray_deep"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="@string/no_message"/>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>
