<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/iv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_centent"
            android:layout_centerInParent="true"
            style="@style/app_title"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_menu"
            android:background="@drawable/btn_menu_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_back"
            android:background="@drawable/btn_menu_normal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_centent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="59dp">
                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cloud_icon_original"
                    android:layout_centerHorizontal="true"/>
                <com.sengled.cloud.ui.view.ThButton
                    android:textSize="@dimen/content_size"
                    android:textColor="@color/text_plain_gray_deep"
                    android:id="@+id/bt_longin"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/longIn"
                    android:layout_below="@+id/iv_icon"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/vw_line2"
                android:background="@color/background_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"/>
            <RelativeLayout
                android:id="@+id/rl_message"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.sengled.cloud.ui.view.ThTextView
                    android:textSize="@dimen/content_size"
                    android:textColor="@color/text_plain_gray_deep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/msg_center"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:background="@drawable/cloud_msg_count_background"
                    android:paddingLeft="15dp"
                    android:paddingTop="2dp"
                    android:paddingRight="15dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="17dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">
                    <com.sengled.cloud.ui.view.ThTextView
                        android:textSize="@dimen/content_size"
                        android:textColor="@color/text_plain_white"
                        android:gravity="center"
                        android:id="@+id/tv_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"/>
                </LinearLayout>
            </RelativeLayout>
            <View
                android:id="@+id/vw_line3"
                android:background="@color/background_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"/>
            <RelativeLayout
                android:id="@+id/rl_feedback"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.sengled.cloud.ui.view.ThTextView
                    android:textSize="@dimen/content_size"
                    android:textColor="@color/text_plain_gray_deep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/feed_back"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/vw_line4"
                android:background="@color/background_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"/>
            <RelativeLayout
                android:id="@+id/rl_modification"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.sengled.cloud.ui.view.ThTextView
                    android:textSize="@dimen/content_size"
                    android:textColor="@color/text_plain_gray_deep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/alter_pwd"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/vw_line5"
                android:background="@color/background_line"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"/>
            <RelativeLayout
                android:id="@+id/rl_logOut"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <com.sengled.cloud.ui.view.ThTextView
                    android:textSize="@dimen/content_size"
                    android:textColor="@color/text_plain_gray_deep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/logOut"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/vw_line6"
                android:background="@color/background_line"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"/>
            <com.sengled.cloud.ui.view.ThButton
                android:id="@+id/bt_test"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="行为统计测试"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
