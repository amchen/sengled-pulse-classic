<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cloud_bt_item_backgroud"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon1"
        android:paddingLeft="7dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/cloud_icon_pic"/>
    <ImageView
        android:id="@+id/iv_icon2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="7dp"
        android:layout_toLeftOf="@+id/iv_icon2"
        android:layout_toRightOf="@+id/iv_icon1"
        android:layout_alignParentTop="true">
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/content_size"
            android:textColor="@color/text_plain_gray_deep"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"/>
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/list_item_size"
            android:textColor="@color/text_plain_gray_deep"
            android:ellipsize="end"
            android:id="@+id/tv_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
