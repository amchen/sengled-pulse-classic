<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@drawable/prompt_top_red"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp">
            <com.sengled.stspeaker.widget.ThTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_title"
                android:layout_centerInParent="true"
                style="@style/DialogTitleText"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_up"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@color/background_plain"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:layout_gravity="left"
            android:orientation="vertical"
            android:id="@+id/prompt_content"
            android:background="@color/btn_normal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="left"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="12dp">
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/tv_info0"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_0"
                    style="@style/DialogText"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/tv_info"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/welcome_1"
                    style="@style/DialogText"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/tv_info2"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/welcome_2"
                    style="@style/DialogText"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/tv_info3"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/welcome_3"
                    style="@style/DialogText"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/tv_info4"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/welcome_4"
                    style="@style/DialogText"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_checkbox"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/a66_checkbox_red_normal_selector"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:textColor="@color/title_bg"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_checkbox_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:text="@string/show_agin"
                    style="@style/DialogText3"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@color/background_plain"
            android:scaleType="fitXY"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/prompt_bottom_selector"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="@string/ok"
            style="@style/DialogTitleButton"/>
    </LinearLayout>
</ScrollView>
