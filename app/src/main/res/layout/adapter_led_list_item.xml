<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="17dp"
    android:paddingBottom="17dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp">
    <RelativeLayout
        android:id="@+id/item_bg"
        android:background="@drawable/shape_lightsetting_bg"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/lamp_setting_margin"
        android:layout_marginRight="@dimen/lamp_setting_margin">
        <ImageView
            android:id="@+id/on_off"
            android:background="@drawable/shape_lightsetting_onoff_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/lightsetting_off"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="18dp"
            android:textColor="@color/text_plain_gray_deep"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/lampname"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="hihihih"
            android:singleLine="true"
            android:layout_toRightOf="@+id/on_off"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/on_off"
            android:layout_below="@+id/lampname">
            <SeekBar
                android:disabledAlpha="1"
                android:id="@+id/sb_control"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="8dp"
                android:max="100"
                android:progress="50"
                android:indeterminate="false"
                style="@style/Widget.SeekBar.Normal"/>
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="18dp"
                android:textColor="@color/text_plain_gray_low"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/lost_connection"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lost_connection"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
