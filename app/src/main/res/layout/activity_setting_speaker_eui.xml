<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_plain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/control_actionbar"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.stspeaker.widget.ThTextView
            android:id="@+id/cp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_setting"
            android:layout_centerInParent="true"
            style="@style/TopTitleTextView"/>
        <Button
            android:id="@+id/btn_menu"
            android:background="@drawable/btn_menu_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_gap1"
        android:background="@drawable/black_gap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/control_actionbar"/>
    <RelativeLayout
        android:id="@+id/bar_eq"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="9dp"
        android:layout_below="@+id/control_actionbar"
        android:layout_centerHorizontal="true">
        <com.sengled.stspeaker.widget.ThTextView
            android:textColor="@color/text_deep"
            android:id="@+id/EQ"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/EQ_preset"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <Button
            android:id="@+id/btn_select"
            android:background="@drawable/eq_down"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/EQ"
            android:layout_alignParentRight="true"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="14sp"
            android:textColor="@color/text"
            android:gravity="center_vertical"
            android:id="@+id/btn_info"
            android:background="@drawable/eq_background1"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/icn_normal_selected"
            android:drawableRight="@drawable/icn_eq_normal_selected"
            android:drawablePadding="5dp"
            android:layout_toLeftOf="@+id/btn_select"
            android:layout_below="@+id/EQ"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/bar_eq">
        <ScrollView
            android:id="@+id/eq_panel_scroll"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="9dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_drop_down_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_move_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_gap2"
                android:background="@color/background_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp">
                <com.sengled.stspeaker.widget.ThTextView
                    android:textColor="@color/text_deep"
                    android:id="@+id/tv_sound_channel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/sound_channel"
                    android:layout_weight="1"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:textColor="@color/text_deep"
                    android:id="@+id/tv_mute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upcase_mute"/>
            </LinearLayout>
            <ListView
                android:id="@+id/listview_speaker"
                android:fadingEdge="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:cacheColorHint="#00000000"
                android:divider="@color/background_plain"
                android:dividerHeight="1px"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
