<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/about_actionbar"
        android:background="@color/a66_title_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/about_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_normal"
            android:layout_alignParentLeft="true"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_plain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download_address"
            android:layout_centerInParent="true"
            style="@style/a66_title"/>
        <Button
            android:id="@+id/about_menu"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/about_actionbar">
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
        <ListView
            android:id="@+id/lv"
            android:padding="20dp"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:listSelector="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/a66_background_plain"
            android:dividerHeight="1dp"/>
    </LinearLayout>
</RelativeLayout>
