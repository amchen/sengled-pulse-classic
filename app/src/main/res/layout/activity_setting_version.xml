<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/control_actionbar"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <com.sengled.stspeaker.widget.ThTextView
            android:id="@+id/cp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_version"
            android:layout_centerInParent="true"
            style="@style/TopTitleTextView"/>
        <Button
            android:id="@+id/btn_menu"
            android:background="@drawable/btn_menu_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rt_web"
        android:layout_below="@+id/control_actionbar">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/product_logo"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="@dimen/tab_text_size"
            android:textColor="@color/text_deep"
            android:id="@+id/tv_version_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version_num"
            android:layout_toRightOf="@+id/tv_version"
            style="@style/ListviewItemText1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rt_web"
        android:background="@drawable/a66_list_item_full"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_above="@+id/bottom_info">
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="@dimen/tab_text_size"
            android:textColor="@color/text_deep"
            android:id="@+id/tv_web"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/web_info"
            android:layout_centerVertical="true"
            style="@style/ListVersionText1"/>
        <Button
            android:background="@drawable/next_arrow"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/copyright_margin"
        android:layout_marginBottom="@dimen/copyright_margin"
        android:layout_alignParentBottom="true">
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="@dimen/a66_copy_right"
            android:textColor="@color/text_deep"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/copyright"/>
    </LinearLayout>
</RelativeLayout>
