<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/control_actionbar"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.stspeaker.widget.ThTextView
            android:id="@+id/cp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/devices_management"
            android:layout_centerInParent="true"
            style="@style/TopTitleTextView"/>
        <Button
            android:id="@+id/btn_menu"
            android:background="@drawable/btn_menu_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_gap1"
        android:background="@drawable/black_gap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <ListView
        android:id="@+id/lv_namelist"
        android:fadingEdge="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:cacheColorHint="#00000000"
        android:divider="@color/background_line"
        android:dividerHeight="1px"
        android:layout_weight="1"/>
    <RelativeLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/add_new_device"
        android:background="@drawable/btn_gray_oval"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="14dp">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="@dimen/add_bulbs_btn"
                android:textColor="@color/dialog_btn_text"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_new_device"
                android:drawableLeft="@drawable/add_icon"
                android:drawablePadding="13dp"
                style="@style/NormalText"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
