<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/title_layout"
        android:background="@drawable/cloud_alert_dialog_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="15dp">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/content_size"
                android:textColor="@color/text_plain_gray_deep"
                android:gravity="center_vertical"
                android:id="@+id/content"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_update_fail"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:background="@color/background_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/title_layout"/>
    <LinearLayout
        android:background="@drawable/cloud_alert_dialog_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="0.5dp"
            android:layout_weight="1">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/normal_size"
                android:textColor="@color/gray"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/cloud_alert_dialog_bottom_left_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/later"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5dp"
            android:layout_weight="1">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/normal_size"
                android:textColor="@color/title_bg"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/cloud_alert_dialog_bottom_right_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/retry"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
