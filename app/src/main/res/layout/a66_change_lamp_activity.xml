<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/a66_act_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/change_lamp_top"
        android:background="@color/a66_title_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/change_lamp_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_normal"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/change_lamp_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/change_lamp_refresh_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_refresh"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_plain"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_device"
            android:layout_toLeftOf="@+id/change_lamp_refresh"
            android:layout_toRightOf="@+id/change_lamp_back"
            android:layout_centerInParent="true"
            style="@style/a66_title"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/change_lamp_top">
        <ImageView
            android:id="@+id/change_lamp_split"
            android:background="@drawable/a66_black_gap"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/change_lamp_split">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/change_lamp_selected_layout"
                android:padding="@dimen/a66_list_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">
                <com.sengled.pulsea66.view.ThTextView
                    android:textColor="@color/a66_text_red"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@string/change_lamp_selected"
                    style="@style/a66_setting_text"/>
                <RelativeLayout
                    android:id="@+id/linked_item"
                    android:background="@drawable/a66_list_item_full"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <ImageView
                        android:id="@+id/selected_left_icon"
                        android:background="@drawable/a66_lamp_selected_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/selected_right_icon"
                        android:background="@drawable/a66_lamp_name_modify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                    <com.sengled.pulsea66.view.ThTextView
                        android:textColor="@color/a66_text_red"
                        android:id="@+id/selected_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toLeftOf="@+id/selected_right_icon"
                        android:layout_toRightOf="@+id/selected_left_icon"
                        android:layout_centerVertical="true"
                        style="@style/a66_title"/>
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/change_lamp_no_selected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/change_lamp_selected_layout">
                <com.sengled.pulsea66.view.ThTextView
                    android:textColor="@color/a66_text_red"
                    android:gravity="center"
                    android:id="@+id/change_lamp_no_selected_title"
                    android:padding="@dimen/a66_list_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@string/change_lamp_no_selected"
                    style="@style/a66_setting_text"/>
                <ListView
                    android:id="@+id/no_selected_list"
                    android:padding="@dimen/a66_list_padding"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:listSelector="#00000000"
                    android:scrollingCache="false"
                    android:cacheColorHint="#00000000"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/no_device_available_lin"
        android:background="@drawable/square_item_selector"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_device_available"
                style="@style/SettingTextView"/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/next_arrow"/>
    </LinearLayout>
</RelativeLayout>
