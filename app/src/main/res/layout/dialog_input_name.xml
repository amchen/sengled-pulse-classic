<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/prompt_top_red"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ln_locate"
            android:visibility="gone"
            android:clickable="true"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="@dimen/locate_size"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/locate_name"/>
            <Button
                android:id="@+id/btn_locate"
                android:background="@drawable/btn_locate_normal_selector"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"/>
        </LinearLayout>
        <com.sengled.stspeaker.widget.ThTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/input_name"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            style="@style/DialogTitleText2"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_up"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/btn_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@drawable/input_bg"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="15dp">
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="20sp"
                android:textColor="@color/text_plain_gray_low"
                android:gravity="center"
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="0/15"
                android:singleLine="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/DialogText2"/>
            <com.sengled.cloud.ui.view.ThEditText
                android:textSize="20sp"
                android:textColor="@color/text_plain_gray_deep"
                android:textColorHint="@color/text_plain_gray_low"
                android:id="@+id/edt_name"
                android:background="@android:color/transparent"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:hint="@string/control_pannel"
                android:singleLine="true"
                android:maxLength="15"
                android:layout_toLeftOf="@+id/tv_count"
                android:layout_centerVertical="true"
                android:inputType="text"
                style="@style/DialogText2"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/disconnect_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="0.5px"
            android:layout_weight="1">
            <com.sengled.stspeaker.widget.ThTextView
                android:gravity="center"
                android:id="@+id/btn_cancle"
                android:background="@drawable/disconnect_bottom_left_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                style="@style/DialogTitleButton"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_ok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5px"
            android:layout_weight="1">
            <com.sengled.stspeaker.widget.ThTextView
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/disconnect_bottom_right_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                style="@style/DialogTitleButton"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
