<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/prompt_title_layout"
        android:background="@drawable/a66_prompt_top_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="20sp"
                android:textColor="@color/a66_text_deep"
                android:layout_gravity="center"
                android:id="@+id/prompt_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/a66_background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:layout_gravity="left"
        android:orientation="vertical"
        android:id="@+id/prompt_content"
        android:background="@color/a66_btn_normal"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/check_box_view"
        android:background="@color/a66_btn_normal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/prompt_show"
            android:paddingLeft="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/a66_checkbox_normal_selector"
            android:scaleType="center"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textSize="15sp"
            android:textColor="@color/a66_text_gray"
            android:layout_gravity="center_vertical"
            android:id="@+id/check_box_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/show_agin"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/a66_background_line"
        android:scaleType="fitXY"/>
    <com.sengled.pulsea66.view.ThTextView
        android:textSize="20sp"
        android:textColor="@color/a66_text_red"
        android:gravity="center"
        android:id="@+id/prompt_ok"
        android:background="@drawable/a66_prompt_bottom_selector"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/ok"/>
</LinearLayout>
