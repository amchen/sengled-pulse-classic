<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background_plain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sengled.stspeaker.widget.ThTextView
        android:id="@+id/lampname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        style="@style/ListviewItemText1"/>
    <RelativeLayout
        android:id="@+id/control_actionbar"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lampname"
        android:layout_alignParentLeft="true">
        <Button
            android:id="@+id/btn_down"
            android:background="@drawable/btn_ls_down_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <Button
            android:id="@+id/btn_up"
            android:background="@drawable/btn_ls_up_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_toRightOf="@+id/btn_down"
            android:layout_alignTop="@+id/btn_down"/>
    </RelativeLayout>
    <com.sengled.stspeaker.widget.ThTextView
        android:textSize="18sp"
        android:id="@+id/tv_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="@string/percent_tag"
        android:layout_alignTop="@+id/control_actionbar"
        android:layout_alignParentRight="true"
        style="@style/Title2TextView"/>
    <com.sengled.stspeaker.widget.ThTextView
        android:textSize="35sp"
        android:id="@+id/tv_brightnessValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/tv_percent"
        android:layout_alignTop="@+id/control_actionbar"
        style="@style/Title2TextView"/>
</RelativeLayout>
