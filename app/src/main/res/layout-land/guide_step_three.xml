<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:guide="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/arr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="120dp"
            android:src="@drawable/guide_arr1_p"
            android:layout_below="@+id/lin"
            android:layout_alignRight="@+id/lin"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/lin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="80dp">
            <com.sengled.stspeaker.widget.GuideZxingContentTextView
                android:id="@+id/content"
                android:paddingBottom="5dp"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:lineSpacingExtra="@dimen/guide_space_extra"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/arr">
                <com.sengled.stspeaker.widget.SkipView
                    android:id="@+id/guide_three_skip"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    guide:guideType="skip"
                    guide:rotate="-98"/>
                <ImageView
                    android:id="@+id/guid_three_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/guide_icon3_p"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
