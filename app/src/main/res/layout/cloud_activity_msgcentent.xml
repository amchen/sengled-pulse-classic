<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/info_title"
            android:layout_centerInParent="true"
            style="@style/app_title"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_back"
            android:background="@drawable/back_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <com.sengled.cloud.ui.view.RefreshListView
        android:id="@+id/lv_message"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@android:color/transparent"
        android:divider="@color/background_line"
        android:dividerHeight="1dp"
        android:layout_below="@+id/rl_title"/>
    <RelativeLayout
        android:id="@+id/rl_nomessage"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_title">
        <ImageView
            android:id="@+id/iv_nomessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:src="@drawable/cloud_icon_nomeessage"
            android:layout_centerHorizontal="true"/>
        <com.sengled.cloud.ui.view.ThTextView
            android:textColor="@color/text_plain_gray_deep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/no_message"
            android:layout_below="@+id/iv_nomessage"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
