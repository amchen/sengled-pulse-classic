<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/prompt_top_red"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="10dp">
        <com.sengled.stspeaker.widget.ThTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_failed_title"
            android:layout_centerInParent="true"
            style="@style/DialogTitleText"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_up"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/btn_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="15dp">
            <com.sengled.stspeaker.widget.ThTextView
                android:id="@+id/tv_info"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_failed_info"
                style="@style/DialogText"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <com.sengled.stspeaker.widget.ThTextView
        android:gravity="center"
        android:id="@+id/btn_ok"
        android:background="@drawable/prompt_bottom_selector"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/ok"
        style="@style/DialogTitleButton"/>
</LinearLayout>
