<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cloud_normal_dialog_bg_gray"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bt_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cloud_close_dialog"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp">
        <ImageView
            android:id="@+id/iv_v1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:src="@drawable/cloud_icon_original"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_v2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:src="@drawable/cloud_icon_man"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_v3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/cloud_icon_woman"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
