<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/prompt_top_red"
            android:paddingLeft="12dp"
            android:paddingTop="15dp"
            android:paddingRight="12dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.sengled.stspeaker.widget.ThTextView
                android:id="@+id/tv_content"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_type_prompt_content"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="3dp"
                style="@style/DialogTitleText"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_above="@+id/tv_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_checkbox"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/a66_checkbox_red_normal_selector"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:textColor="@color/title_bg"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_checkbox_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/show_agin"
                    style="@style/DialogText3"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@color/background_plain"
            android:scaleType="fitXY"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:gravity="center"
            android:id="@+id/btn_ok"
            android:background="@drawable/prompt_bottom_selector"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="@string/ok"
            style="@style/DialogTitleButton"/>
    </LinearLayout>
</ScrollView>
