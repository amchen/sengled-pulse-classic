<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/prompt_title_layout"
        android:background="@drawable/cloud_alert_dialog_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/cloud_alert_dialog_top"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/normal_size"
                android:textColor="@color/text_plain_gray_deep"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/alert"/>
        </LinearLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@color/background_line"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="left"
        android:orientation="vertical"
        android:id="@+id/prompt_content"
        android:background="@color/btn_normal"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/content_size"
            android:textColor="@color/text_plain_gray_deep"
            android:id="@+id/alert_msg"
            android:paddingLeft="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:background="@drawable/cloud_alert_dialog_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="0.5dp"
            android:layout_weight="1">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/normal_size"
                android:textColor="@color/title_bg"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/cloud_alert_dialog_bottom_left_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/alert_dialog_cancel"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5dp"
            android:layout_weight="1">
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/normal_size"
                android:textColor="@color/title_bg"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/cloud_alert_dialog_bottom_right_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/alert_dialog_ok"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
