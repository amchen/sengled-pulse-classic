<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#99000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/change_lamp_edit_back"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_normal"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/change_lamp_edit_refresh"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_refresh"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_red"
            android:gravity="center"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/change_lamp"
            android:layout_toLeftOf="@+id/change_lamp_edit_refresh"
            android:layout_toRightOf="@+id/change_lamp_edit_back"
            android:layout_centerInParent="true"
            style="@style/a66_title"/>
    </RelativeLayout>
    <ImageView
        android:background="@drawable/a66_black_gap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/a66_list_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_red"
            android:gravity="center"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="3dp"
            android:text="@string/change_lamp_selected"
            style="@style/a66_setting_text"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/lamp_edit_cancel"
                android:background="@drawable/a66_lamp_change_name_cancel_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/a66_lamp_change_name_cancel"/>
            </LinearLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:background="@drawable/a66_lamp_change_name_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/lamp_edit_cancel">
                <ImageView
                    android:id="@+id/lamp_edit_icon"
                    android:background="@drawable/a66_lamp_selected_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"/>
                <ImageView
                    android:id="@+id/lamp_edit_modify"
                    android:background="@drawable/a66_lamp_name_modify_ok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_alignParentRight="true"/>
                <EditText
                    android:id="@+id/lamp_edit_name"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:singleLine="true"
                    android:layout_toLeftOf="@+id/lamp_edit_modify"
                    android:layout_toRightOf="@+id/lamp_edit_icon"
                    android:layout_centerVertical="true"
                    style="@style/a66_title"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
