<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <ImageView
        android:background="@drawable/a66_black_gap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/a66_firmware_icon"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textSize="17sp"
            android:textColor="@color/a66_text_gray"
            android:id="@+id/tv_version_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/version_num"
            android:layout_toRightOf="@+id/tv_version"
            style="@style/a66_title"/>
    </LinearLayout>
    <com.sengled.pulsea66.view.ThTextView
        android:textSize="@dimen/list_item_size"
        android:gravity="top"
        android:id="@+id/content"
        android:background="@drawable/a66_list_item_full"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/no_firmware_update"
        android:lineSpacingExtra="5dp"
        style="@style/SettingTextView"/>
</LinearLayout>
