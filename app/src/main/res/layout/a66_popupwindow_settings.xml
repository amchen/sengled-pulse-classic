<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/pop_layout"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_rt"
        android:background="@color/a66_title_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_plain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu"
            android:layout_centerInParent="true"
            style="@style/a66_title"/>
        <Button
            android:id="@+id/bt_cancle"
            android:background="@drawable/menu_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/a66_act_bg"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/personal_center"
            android:background="@drawable/menu_item_selector"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_dot1"
                android:paddingLeft="12dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_checkbox_red_normal_selector"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personal_center"
                android:layout_toRightOf="@+id/iv_dot1"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/SettingTextView"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/settings"
            android:background="@drawable/menu_item_selector"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <ImageView
                android:id="@+id/iv_dot3"
                android:paddingLeft="12dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_checkbox_red_normal_selector"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:layout_toRightOf="@+id/iv_dot3"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/SettingTextView"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/about"
            android:background="@drawable/menu_item_selector"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <ImageView
                android:id="@+id/iv_dot2"
                android:paddingLeft="12dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_checkbox_red_normal_selector"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about"
                android:layout_toRightOf="@+id/iv_dot2"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/SettingTextView"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/switch_device"
            android:background="@drawable/menu_item_selector"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <ImageView
                android:id="@+id/iv_dot4"
                android:paddingLeft="12dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_checkbox_red_normal_selector"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switch_device"
                android:layout_toRightOf="@+id/iv_dot4"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/SettingTextView"/>
            <ImageView
                android:textSize="@dimen/content_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="17dp"
                android:src="@drawable/switchdevice"
                android:text="0"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
