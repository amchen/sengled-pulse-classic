<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/prompt_title_layout"
        android:background="@drawable/a66_prompt_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/a66_prompt_top_red"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="45dp">
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="20sp"
                android:textColor="@color/a66_text_deep"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/update_available"/>
        </LinearLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@color/a66_background_line"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="left"
        android:orientation="vertical"
        android:background="@color/a66_btn_normal"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.pulsea66.view.ThTextView
            android:textSize="17sp"
            android:textColor="@color/a66_text_gray"
            android:id="@+id/content_tv"
            android:paddingLeft="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/content"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/a66_background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:id="@+id/ll_button"
        android:background="@drawable/a66_disconnect_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="0.5dp"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="20sp"
                android:textColor="@color/a66_text_gray"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/a66_disconnect_bottom_left_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/not_now"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5px"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="20sp"
                android:textColor="@color/a66_text_red"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/a66_disconnect_bottom_right_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/update"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
