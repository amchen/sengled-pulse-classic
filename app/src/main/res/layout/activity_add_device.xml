<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:panel="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_device_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@color/background_plain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/add_device_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/control_actionbar"
                android:background="@color/title_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/cp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_new_device"
                    android:layout_centerInParent="true"
                    style="@style/TopTitleTextView"/>
                <Button
                    android:id="@+id/btn_menu"
                    android:background="@drawable/btn_menu_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_gap1"
                android:background="@drawable/black_gap"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/add_device_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/ll_camera"
                    android:background="@drawable/btn_red_oval"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="8">
                    <com.sengled.stspeaker.widget.ThTextView
                        android:textSize="@dimen/add_bulbs_btn"
                        android:textColor="@color/dialog_btn_text"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_camera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scanning_add"
                        android:drawableLeft="@drawable/cameron"
                        android:drawablePadding="13dp"
                        style="@style/NormalText"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/ll_input"
                    android:background="@drawable/btn_red_oval"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_weight="3">
                    <com.sengled.stspeaker.widget.ThTextView
                        android:textSize="@dimen/add_bulbs_btn"
                        android:textColor="@color/dialog_btn_text"
                        android:id="@+id/tv_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input"
                        style="@style/NormalText"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <ListView
            android:id="@+id/lv_device"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="14dp"
            android:cacheColorHint="#00000000"
            android:divider="@color/background_line"
            android:dividerHeight="1px"
            android:layout_above="@+id/add_device_bottom"
            android:layout_below="@+id/add_device_top"/>
        <RelativeLayout
            android:id="@+id/rl_back"
            android:paddingTop="20dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/add_device_bottom"
            android:layout_below="@+id/add_device_top"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/light"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/guide_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/iv_back"
                android:layout_centerHorizontal="true">
                <com.sengled.stspeaker.widget.ThTextView
                    android:textSize="@dimen/no_device_connect"
                    android:id="@+id/tv_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_satellite"
                    style="@style/FullviewText"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/guide_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/guide_icon"/>
                    <TextView
                        android:textSize="@dimen/add_guide"
                        android:textColor="@color/red"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guide_text"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/guide_title_layout">
                <ScrollView
                    android:background="@drawable/add_device_guide_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:padding="@dimen/guide_padding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/wifi1"
                                android:padding="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/wifi"/>
                            <com.sengled.stspeaker.widget.ThTextView
                                android:textSize="@dimen/guide_title"
                                android:textColor="@color/red"
                                android:id="@+id/title1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/add_guide_title1"
                                android:layout_toRightOf="@+id/wifi1"
                                android:layout_alignTop="@+id/wifi1"/>
                            <com.sengled.stspeaker.widget.ThTextView
                                android:textSize="@dimen/guide_content"
                                android:textColor="@color/gray"
                                android:id="@+id/content1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/guide_title_content_space"
                                android:text="@string/add_guide_content1"
                                android:layout_toRightOf="@+id/wifi1"
                                android:layout_below="@+id/title1"
                                android:lineSpacingExtra="@dimen/guide_content_linespacingextra"/>
                            <ImageView
                                android:id="@+id/wifi2"
                                android:padding="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:src="@drawable/wifi"
                                android:layout_below="@+id/content1"/>
                            <com.sengled.stspeaker.widget.ThTextView
                                android:textSize="@dimen/guide_title"
                                android:textColor="@color/red"
                                android:id="@+id/title2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/guide_title_content_space"
                                android:text="@string/add_guide_title2"
                                android:layout_toRightOf="@+id/wifi2"
                                android:layout_alignTop="@+id/wifi2"
                                android:lineSpacingExtra="@dimen/guide_content_linespacingextra"/>
                            <com.sengled.stspeaker.widget.ThTextView
                                android:textSize="@dimen/guide_content"
                                android:textColor="@color/gray"
                                android:id="@+id/content2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_guide_content2"
                                android:layout_toRightOf="@+id/wifi2"
                                android:layout_below="@+id/title2"
                                android:lineSpacingExtra="5dp"/>
                        </RelativeLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
