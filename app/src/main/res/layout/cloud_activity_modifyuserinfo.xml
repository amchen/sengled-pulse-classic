<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/modify_user"
            android:layout_centerInParent="true"
            style="@style/app_title"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_back"
            android:background="@drawable/back_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:src="@drawable/cloud_icon_original"/>
            <RelativeLayout
                android:id="@+id/user_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="22dp"
                android:layout_marginBottom="20dp">
                <ImageView
                    android:id="@+id/iv_token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cloud_icon_token"/>
                <com.sengled.cloud.ui.view.ThEditText
                    android:textColor="@color/text_plain_gray_deep"
                    android:textColorHint="@color/text_plain_gray_low"
                    android:id="@+id/et_token"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:singleLine="true"
                    android:layout_toRightOf="@+id/iv_token"
                    android:layout_alignBottom="@+id/iv_token"/>
                <View
                    android:background="@color/background_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_below="@+id/et_token"
                    android:layout_alignLeft="@+id/et_token"/>
                <ImageView
                    android:id="@+id/iv_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/cloud_icon_email_2"
                    android:layout_below="@+id/iv_token"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_yanzheng"
                    android:background="@drawable/cloud_tips_btn_bg_red"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_alignBottom="@+id/iv_user"
                    android:layout_alignParentRight="true">
                    <com.sengled.cloud.ui.view.ThButton
                        android:textSize="15sp"
                        android:textColor="@color/text_plain_gray_deep"
                        android:id="@+id/bt_validation"
                        android:background="@null"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_bt_validation"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/cloud_icon_validation"/>
                </LinearLayout>
                <com.sengled.cloud.ui.view.ThTextView
                    android:textColor="@color/white_text"
                    android:id="@+id/tv_user"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:singleLine="true"
                    android:layout_toLeftOf="@+id/ll_yanzheng"
                    android:layout_toRightOf="@+id/iv_user"
                    android:layout_alignBottom="@+id/iv_user"/>
                <View
                    android:background="@color/background_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_below="@+id/tv_user"
                    android:layout_alignLeft="@+id/tv_user"/>
                <ImageView
                    android:id="@+id/iv_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/cloud_icon_phone"
                    android:layout_below="@+id/iv_user"/>
                <com.sengled.cloud.ui.view.ThEditText
                    android:textColor="@color/text_plain_gray_deep"
                    android:textColorHint="@color/text_plain_gray_low"
                    android:id="@+id/et_phone"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:hint="@string/et_phone"
                    android:singleLine="true"
                    android:maxLength="50"
                    android:layout_toRightOf="@+id/iv_phone"
                    android:layout_alignBottom="@+id/iv_phone"/>
                <View
                    android:background="@color/background_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_below="@+id/et_phone"
                    android:layout_alignLeft="@+id/et_phone"/>
                <ImageView
                    android:id="@+id/iv_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/cloud_icon_add"
                    android:layout_below="@+id/iv_phone"/>
                <com.sengled.cloud.ui.view.ThEditText
                    android:textColor="@color/text_plain_gray_deep"
                    android:textColorHint="@color/text_plain_gray_low"
                    android:id="@+id/et_other"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:hint="@string/et_other"
                    android:singleLine="true"
                    android:maxLength="50"
                    android:layout_toRightOf="@+id/iv_other"
                    android:layout_alignBottom="@+id/iv_other"/>
                <View
                    android:id="@+id/view"
                    android:background="@color/background_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_below="@+id/et_other"
                    android:layout_alignLeft="@+id/et_other"/>
                <com.sengled.cloud.ui.view.ThButton
                    android:textSize="@dimen/normal_size"
                    android:gravity="center"
                    android:id="@+id/bt_save"
                    android:layout_marginTop="20dp"
                    android:text="@string/bt_save"
                    android:layout_below="@+id/view"
                    style="@style/ActivityBtn"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
