<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/background_plain"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/control_actionbar"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.sengled.stspeaker.widget.ThTextView
                android:textColor="@color/text"
                android:ellipsize="end"
                android:id="@+id/speakername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/NormalText"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <com.sengled.stspeaker.widget.ThTextView
                        android:gravity="center"
                        android:id="@+id/btn_L"
                        android:background="@drawable/btn_l_or_r_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/channel_L"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/imageView1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:src="@drawable/black_gap"
                        android:scaleType="fitXY"
                        android:layout_weight="1"/>
                    <com.sengled.stspeaker.widget.ThTextView
                        android:gravity="center"
                        android:id="@+id/btn_LR"
                        android:background="@drawable/btn_l_and_r_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/channel_LR"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/imageView2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:src="@drawable/black_gap"
                        android:scaleType="fitXY"
                        android:layout_weight="1"/>
                    <com.sengled.stspeaker.widget.ThTextView
                        android:gravity="center"
                        android:id="@+id/btn_R"
                        android:background="@drawable/btn_l_or_r_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/channel_R"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="right"
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_gravity="right"
                        android:id="@+id/btn_mute"
                        android:background="@drawable/btn_unmute_selector_l"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="center"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
