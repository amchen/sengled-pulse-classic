<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/a66_act_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/about_actionbar"
        android:background="@color/a66_title_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <Button
            android:id="@+id/back_btn"
            android:background="@drawable/back_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_plain"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_title"
            android:layout_centerInParent="true"
            style="@style/a66_title"/>
        <Button
            android:id="@+id/about_menu"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <android.support.v4.view.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.sengled.pulsea66.view.CirclePageIndicator
        android:id="@+id/indicator"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <com.sengled.cloud.ui.view.ThButton
        android:textSize="@dimen/content_size"
        android:textColor="@android:color/white"
        android:id="@+id/update"
        android:background="@drawable/a66_update_bottom_selector"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_margin="20dp"
        android:text="@string/update_title"
        android:layout_centerInParent="true"/>
</LinearLayout>
