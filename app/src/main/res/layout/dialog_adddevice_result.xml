<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/prompt_top_red"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="10dp">
        <com.sengled.stspeaker.widget.ThTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/DialogTitleText"/>
    </RelativeLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/a66_background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/btn_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="15dp">
            <com.sengled.stspeaker.widget.ThTextView
                android:id="@+id/tv_info"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_fail"
                style="@style/DialogText"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:background="@drawable/a66_disconnect_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="0.5dp"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="20sp"
                android:textColor="@color/a66_text_red"
                android:gravity="center"
                android:id="@+id/btn_ok"
                android:background="@drawable/prompt_bottom_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/ok"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lin_relink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5px"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="20sp"
                android:textColor="@color/a66_text_red"
                android:gravity="center"
                android:id="@+id/btn_relink"
                android:background="@drawable/prompt_bottom_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/relink"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
