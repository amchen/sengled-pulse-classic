<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/access_name_icon_space">
    <ImageView
        android:layout_width="@dimen/access_icon_width"
        android:layout_height="@dimen/access_icon_height"
        android:src="@mipmap/light"/>
    <ImageView
        android:layout_width="@dimen/access_icon_width"
        android:layout_height="@dimen/access_icon_height"
        android:layout_marginLeft="@dimen/access_icon_marginleft"
        android:src="@mipmap/voice"/>
    <ImageView
        android:layout_width="@dimen/access_icon_width"
        android:layout_height="@dimen/access_icon_height"
        android:layout_marginLeft="@dimen/access_icon_marginleft"
        android:src="@mipmap/bluetooth"/>
    <ImageView
        android:layout_width="@dimen/access_icon_width"
        android:layout_height="@dimen/access_icon_height"
        android:layout_marginLeft="@dimen/access_icon_marginleft"
        android:src="@mipmap/bulb"/>
</LinearLayout>
