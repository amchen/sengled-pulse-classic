<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/app_title"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_back"
            android:background="@drawable/back_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_bottom"
        android:background="@color/bg_gray"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true">
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_return"
            android:background="@drawable/cloud_web_return"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="19dp"
            android:layout_centerVertical="true"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_forward"
            android:background="@drawable/cloud_web_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="51dp"
            android:layout_toRightOf="@+id/bt_return"
            android:layout_centerVertical="true"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_refresh"
            android:background="@drawable/cloud_bt_refresh_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="19dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <WebView
        android:id="@+id/wv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rl_bottom"
        android:layout_below="@+id/rl_title"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/rl_sorry"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rl_bottom"
        android:layout_below="@+id/rl_title">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:src="@drawable/web_error_icon"
            android:layout_centerHorizontal="true"/>
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/web_title"
            android:textColor="@color/title_bg"
            android:id="@+id/iv_icon_errow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sorry"
            android:layout_below="@+id/iv_icon"
            android:layout_centerHorizontal="true"/>
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/content_size"
            android:textColor="@color/text_plain_gray_deep"
            android:gravity="center_horizontal"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/webview_sorry"
            android:layout_below="@+id/iv_icon_errow"/>
    </RelativeLayout>
</RelativeLayout>
