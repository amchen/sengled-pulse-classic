<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/a66_act_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/about_actionbar"
        android:background="@color/a66_title_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/settings_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_normal"
            android:layout_alignParentLeft="true"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textColor="@color/a66_text_plain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:layout_centerInParent="true"
            style="@style/a66_title"/>
        <Button
            android:id="@+id/about_menu"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/memory_ln"
        android:background="@drawable/a66_list_item_top"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_info"
                android:singleLine="true"
                style="@style/SettingTextView"/>
            <ImageView
                android:id="@+id/memory_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_setting_tips"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.SwitchView
            android:id="@+id/memory_sv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/auto_ln"
        android:background="@drawable/a66_list_item_center"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_info"
                android:singleLine="true"
                style="@style/SettingTextView"/>
            <ImageView
                android:id="@+id/auto_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/a66_setting_tips"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.SwitchView
            android:id="@+id/auto_sv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/welcome_ln"
        android:background="@drawable/a66_list_item_bottom"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:gravity="center"
                android:background="@drawable/a66_list_item_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_info"
                style="@style/SettingTextView"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.SwitchView
            android:id="@+id/welcome_sv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/devices_mgmt_ln"
        android:background="@drawable/a66_list_item_full"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_devices_management"
                android:singleLine="true"
                style="@style/SettingTextView"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.SwitchView
            android:id="@+id/devices_mgmt_sv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/media_apps_ln"
        android:background="@drawable/a66_list_item_full"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_launch_media_apps"
                android:singleLine="true"
                style="@style/SettingTextView"/>
        </LinearLayout>
        <com.sengled.pulsea66.view.SwitchView
            android:id="@+id/media_apps_sv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/link_type_ln"
        android:background="@drawable/a66_list_item_full"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.sengled.pulsea66.view.ThTextView
                android:gravity="center"
                android:background="@drawable/a66_list_item_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_title"
                android:singleLine="true"
                style="@style/SettingTextView"/>
        </LinearLayout>
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="15sp"
            android:textColor="@color/bg_gray"
            android:gravity="center"
            android:id="@+id/tv_link_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="17dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/next_arrow"/>
    </LinearLayout>
</LinearLayout>
