<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:guide="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp">
        <com.sengled.stspeaker.widget.GuideContentTextView
            android:textSize="@dimen/guide_nomal"
            android:id="@+id/tv"
            android:paddingTop="@dimen/guide_six_content_top"
            android:paddingBottom="@dimen/guide_six_content_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/six_content"
            android:lineSpacingExtra="@dimen/guide_space_extra"
            android:rotation="-8"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp">
            <ImageView
                android:id="@+id/guid_six_img"
                android:paddingBottom="@dimen/guide_six_image_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/guide_six_image_top"
                android:src="@drawable/guide_icon6"/>
            <com.sengled.stspeaker.widget.SkipView
                android:id="@+id/guide_six_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                guide:guideType="skip"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/arr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/guide_arr1"/>
</RelativeLayout>
