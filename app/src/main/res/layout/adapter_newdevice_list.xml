<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background_plain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sengled.stspeaker.widget.ThTextView
        android:id="@+id/tv_addr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="12345678"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        style="@style/ListviewItemText1"/>
    <RelativeLayout
        android:id="@+id/rl_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/tv_remove"
            android:background="@drawable/delete_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_add"
            android:background="@drawable/btn_normal_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@+id/tv_remove"
            android:layout_centerVertical="true">
            <FrameLayout
                android:id="@+id/fl_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.sengled.stspeaker.widget.ThTextView
                    android:padding="10dp"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/relink"
                    style="@style/NormalText"/>
                <com.sengled.stspeaker.widget.ThTextView
                    android:id="@+id/tv_add"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/link"
                    style="@style/NormalText"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/iv_info"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/green_light_list"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
