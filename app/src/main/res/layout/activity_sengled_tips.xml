<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tips_page1"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/tips_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="27sp"
                android:textColor="@color/black1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_install"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/tips_finish_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="25dp"
                android:src="@mipmap/tips_finish"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="18sp"
            android:id="@+id/tips1_comment"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:text="@string/tipspage1_comment"
            android:layout_weight="1.7"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/tips_gif1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_weight="3.5"
            android:layout_centerInParent="true"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="21sp"
            android:textColor="@color/black1"
            android:id="@+id/tips_content_1"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="@string/tipspage1_content"
            android:layout_weight="1.5"
            android:lineSpacingExtra="5dp"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textSize="20sp"
            android:textColor="#e42f3f"
            android:gravity="center"
            android:id="@+id/next_tip_1"
            android:background="@drawable/tips_next_selector"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="9dp"
            android:text="@string/tips_next"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tips_page2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/tips_title2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="27sp"
                android:textColor="@color/black1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_bluetooth"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/tips_finish_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="25dp"
                android:src="@mipmap/tips_finish"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="15sp"
            android:textColor="@color/black1"
            android:id="@+id/tips_content_2"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/tips2page_content"
            android:layout_weight="1.7"
            android:lineSpacingExtra="5dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/tips_gif2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_weight="3.5"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/dialog_tip"
            android:background="@drawable/tips_next_selector"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/icon_help"/>
            <com.sengled.pulsea66.view.ThTextView
                android:textSize="15sp"
                android:textColor="#e42f3f"
                android:id="@+id/help_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tipspage2_comment"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:gravity="center"
            android:id="@+id/tipspage2_comment2"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:text="@string/tipspage2_comment2"
            android:layout_weight="1.7"
            android:layout_centerHorizontal="true"/>
        <com.sengled.pulsea66.view.ThTextView
            android:textSize="20sp"
            android:textColor="#e42f3f"
            android:gravity="center"
            android:id="@+id/next_tip_2"
            android:background="@drawable/tips_next_selector"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="9dp"
            android:text="@string/tips_next"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</RelativeLayout>
