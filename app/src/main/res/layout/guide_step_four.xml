<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:guide="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sengled.stspeaker.widget.GuideContentTextView
        android:textSize="@dimen/guide_nomal"
        android:id="@+id/content"
        android:paddingLeft="18dp"
        android:paddingTop="@dimen/guide_four_content_top"
        android:paddingRight="18dp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/four_content"
        android:layout_below="@+id/guid_four_img"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="@dimen/guide_space_extra"
        android:rotation="-8"/>
    <com.sengled.stspeaker.widget.SkipView
        android:id="@+id/guide_four_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/content"
        android:layout_alignRight="@+id/content"
        guide:guideType="skip"/>
    <ImageView
        android:id="@+id/guid_four_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/guide_arr4"
        android:layout_alignRight="@+id/content"/>
</RelativeLayout>
