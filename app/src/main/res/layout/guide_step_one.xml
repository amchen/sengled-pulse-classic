<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:guide="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/guid_one_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/guide_arr1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_toRightOf="@+id/guid_one_img"
        android:rotation="-8">
        <com.sengled.stspeaker.widget.GuideContentTextView
            android:textSize="@dimen/guide_nomal"
            android:id="@+id/tv"
            android:paddingBottom="@dimen/guide_one_content_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/one_top_content"
            android:singleLine="true"/>
        <com.sengled.stspeaker.widget.GuideContentTextView
            android:textSize="@dimen/guide_small"
            android:gravity="center_horizontal"
            android:id="@+id/tv2"
            android:paddingBottom="@dimen/guide_one_content_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/guide_space_extra"
            android:text="@string/one_bottom_content"
            android:layout_below="@+id/tv"
            android:lineSpacingExtra="@dimen/guide_space_extra"/>
    </LinearLayout>
    <com.sengled.stspeaker.widget.SkipView
        android:id="@+id/guide_one_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/content"
        android:layout_alignRight="@+id/content"
        guide:guideType="skip"/>
</RelativeLayout>
