<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/dialog_bg_layout"
    android:background="@color/dialog_bg_translucent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cloud_loading_background"
        android:padding="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/loading_circle_outer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cloud_load_icon"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/loading_circle_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cloud_load_icon2"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/content_size"
            android:textColor="@color/title_bg"
            android:id="@+id/dialog_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/loading"/>
    </LinearLayout>
</LinearLayout>
