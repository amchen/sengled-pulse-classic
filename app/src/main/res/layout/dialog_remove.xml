<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/prompt_top_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="15dp">
            <com.sengled.stspeaker.widget.ThTextView
                android:id="@+id/tv_info"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove_scan_item"
                style="@style/DialogText"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/background_line"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/disconnect_bottom_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_quite"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="0.5px"
            android:layout_weight="1">
            <com.sengled.stspeaker.widget.ThTextView
                android:gravity="center"
                android:id="@+id/btn_quite"
                android:background="@drawable/disconnect_bottom_left_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                style="@style/DialogTitleButton"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_refind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.5px"
            android:layout_weight="1">
            <com.sengled.stspeaker.widget.ThTextView
                android:gravity="center"
                android:id="@+id/btn_refind"
                android:background="@drawable/disconnect_bottom_right_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ok"
                style="@style/DialogTitleButton"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
