<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TITLE"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_titile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_launcher"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_main"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="Main"/>
    </RelativeLayout>
    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:id="@+id/rl_uscenter"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_uscenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="个人中心"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_uscenter"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/ic_launcher"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_edit_labels"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_edit_labels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="edit_labels"/>
    </RelativeLayout>
    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_refresh"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="refresh"/>
    </RelativeLayout>
    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_add_device"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/add_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="add_device"/>
    </RelativeLayout>
    <View
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/rl_about"
        android:background="#7c7c7c"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="about"/>
    </RelativeLayout>
</LinearLayout>
