<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cloud_feed_message_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="9dp"
        android:src="@drawable/cloud_icon_time"/>
    <com.sengled.cloud.ui.view.ThTextView
        android:textSize="@dimen/small_text_size"
        android:textColor="@color/text_plain_gray_deep"
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="10dp"
        android:text="2012-19-12"
        android:layout_toRightOf="@+id/iv_icon"/>
    <com.sengled.cloud.ui.view.ThTextView
        android:textSize="@dimen/small_text_size"
        android:textColor="@color/text_plain_gray_deep"
        android:id="@+id/tv_return"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/iv_icon"/>
    <com.sengled.cloud.ui.view.ThTextView
        android:textSize="@dimen/small_text_size"
        android:textColor="@color/text_plain_blue"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:layout_below="@+id/tv_return"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/tv_content"/>
</RelativeLayout>
