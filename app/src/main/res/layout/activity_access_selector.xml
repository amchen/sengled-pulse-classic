<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:panel="http://schemas.android.com/apk/res-auto"
    android:background="#d11c2c"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.sengled.stspeaker.widget.ExtScrollView
        android:id="@+id/diveces_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:textSize="@dimen/title_size"
                android:gravity="center"
                android:layout_gravity="center"
                android:background="@drawable/red_rectangle1"
                android:padding="@dimen/access_selector_title_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/access_logo"/>
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="@dimen/content_size"
                android:textColor="#fcf2f3"
                android:gravity="center"
                android:layout_gravity="center"
                android:padding="@dimen/access_selector_welcome_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/access_selector_welcome"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/pulse"
                    android:background="@drawable/pulse_background"
                    android:padding="5dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pulse_icon1"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_pulse"/>
                        <include layout="@layout/access_pulse"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"/>
                <RelativeLayout
                    android:id="@+id/pulse_solo"
                    android:background="@drawable/solo_background"
                    android:padding="5dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon1"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pulse_solo_icon1"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon1"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_solo"/>
                        <include layout="@layout/access_pulse_solo"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"/>
                <RelativeLayout
                    android:id="@+id/pulse_single"
                    android:background="@drawable/pulse_single_background"
                    android:padding="5dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon3"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pulse_icon1"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon3"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_s"/>
                        <include layout="@layout/access_pulse_s"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"/>
                <RelativeLayout
                    android:id="@+id/pulse_link"
                    android:background="@drawable/link_background"
                    android:padding="5dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon4"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/pulse_link_icon"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon4"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_link"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/access_name_icon_space"
                            android:src="@drawable/pulse_link_icon2"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"/>
                <RelativeLayout
                    android:id="@+id/pulse_2"
                    android:background="@mipmap/pulse2_bg"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon5"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/pulse2_icon"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon5"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_pulse_2"/>
                        <include layout="@layout/access_pulse_2"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"/>
                <RelativeLayout
                    android:id="@+id/solo_pro"
                    android:background="@mipmap/solopro_bg"
                    android:padding="5dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon6"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/solopro_icon"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon6"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_solo_pro"/>
                        <include layout="@layout/access_solo_pro"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"/>
                <RelativeLayout
                    android:id="@+id/pulse_wave"
                    android:background="@mipmap/pulse_wave_bg"
                    android:padding="5dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/icon7"
                        android:padding="@dimen/access_left_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/pulse_wave_icon"
                        android:layout_centerVertical="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/icon7"
                        android:layout_centerVertical="true">
                        <com.sengled.stspeaker.widget.ThTextView
                            android:textSize="@dimen/access_selector_size"
                            android:textColor="#fcfcfc"
                            android:id="@+id/tv6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/access_selector_pulse_wave"/>
                        <include layout="@layout/access_pulse_wave"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"/>
        </LinearLayout>
    </com.sengled.stspeaker.widget.ExtScrollView>
    <FrameLayout
        android:id="@+id/auto_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ck_lin"
            android:background="@drawable/red_rectangle"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@+id/ck"
                android:background="@drawable/access_checkbox_selector"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:button="@null"/>
            <com.sengled.pulsea66.view.ThTextView
                android:textColor="#fcfcfc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automatic_selecte_device"
                android:singleLine="true"
                style="@style/SettingTextView"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/animation_lin"
            android:background="@drawable/red_rectangle"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.sengled.pulsea66.view.ThTextView
                android:textColor="#fcfcfc"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_device_available"
                android:singleLine="true"
                style="@style/SettingTextView"/>
        </LinearLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/pulldown_arrow"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@mipmap/pulldown_arror"
        android:layout_above="@+id/auto_connect"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
