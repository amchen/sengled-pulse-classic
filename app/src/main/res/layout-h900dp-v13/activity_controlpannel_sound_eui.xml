<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/control_actionbar"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_menu"
            android:background="@drawable/btn_menu_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="@dimen/tab_text_size"
            android:id="@+id/cp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sounds"
            android:layout_centerInParent="true"
            style="@style/TopTitleTextView"/>
        <Button
            android:id="@+id/btn_setting"
            android:background="@drawable/settng_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/imageView2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@drawable/black_gap"
        android:scaleType="fitXY"
        android:layout_below="@+id/control_actionbar"
        android:layout_alignParentLeft="true"/>
    <RelativeLayout
        android:id="@+id/fl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tab_action"
        android:layout_below="@+id/imageView2">
        <ImageView
            android:id="@+id/logo_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:src="@drawable/icon_pulse"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
		<com.sengled.stspeaker.widget.CircleView
			android:id="@+id/DialSeekBar"
			android:padding="15dp"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_marginLeft="15dp"
			android:layout_marginTop="8dp"
			android:layout_marginRight="15dp"
			android:layout_above="@+id/logo_icon" />
		<RelativeLayout
			android:id="@+id/soundCountLinear"
			android:layout_width="120dp"
			android:layout_height="120dp"
			android:layout_marginLeft="10dp"
			android:layout_marginTop="10dp"
			android:background="@color/transparent">
			<com.facebook.drawee.view.SimpleDraweeView
				fresco:actualImageScaleType="centerCrop"
				fresco:placeholderImage="@color/viewfinder_mask"
				fresco:placeholderImageScaleType="centerCrop"
				fresco:roundAsCircle="true"
				android:layout_width="55dp"
				android:layout_height="55dp"
				android:layout_centerInParent="true" />
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_centerInParent="true"
				android:orientation="horizontal">
				<ImageView
					android:layout_width="70dp"
					android:layout_height="70dp"
					android:layout_gravity="center"
					android:src="@mipmap/icon_sound" />
				<TextView
					android:id="@+id/tv_sound_count"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center"
					android:textColor="#ea2839"
					android:textSize="20sp" />
			</LinearLayout>
		</RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/tab_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_light"
            android:background="@drawable/tab_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:src="@drawable/icn_light_icon_normal"/>
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="@dimen/tab_text_size"
                android:textColor="@color/text_plain"
                android:id="@+id/tv_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lights"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_sound"
            android:background="@drawable/tab_select_normal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:src="@drawable/icn_sound_icon_selected"/>
            <com.sengled.stspeaker.widget.ThTextView
                android:textSize="@dimen/tab_text_size"
                android:textColor="@color/dialog_btn_text"
                android:id="@+id/tv_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sounds"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
