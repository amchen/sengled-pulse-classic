<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/activity_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.cloud.ui.view.ThTextView
            android:id="@+id/tv_titile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:layout_centerInParent="true"
            style="@style/app_title"/>
        <com.sengled.cloud.ui.view.ThButton
            android:id="@+id/bt_back"
            android:background="@drawable/back_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp">
        <com.sengled.cloud.ui.view.EditTextWithDel
            android:textSize="14dp"
            android:textColor="@color/text_plain_gray_deep"
            android:textColorHint="@color/text_plain_gray_low"
            android:gravity="center_vertical"
            android:id="@+id/et_username"
            android:background="@drawable/cloud_et_info"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="@string/et_user"
            android:singleLine="true"
            android:drawableLeft="@drawable/cloud_icon_email"
            android:drawablePadding="5dp"/>
        <com.sengled.cloud.ui.view.EditTextWithDel
            android:textSize="14dp"
            android:textColor="@color/text_plain_gray_deep"
            android:textColorHint="@color/text_plain_gray_low"
            android:gravity="center_vertical"
            android:id="@+id/et_pwd"
            android:background="@drawable/cloud_et_info"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:hint="@string/et_pwd"
            android:password="true"
            android:singleLine="true"
            android:drawableLeft="@drawable/cloud_icon_pwd"
            android:drawablePadding="5dp"/>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/checkbox_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/checkbox_img"
                android:paddingLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cloud_cb_selector"
                android:scaleType="center"/>
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="@dimen/small_text_size"
                android:textColor="@color/text_plain_gray_deep"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/cb_show_pwd"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <com.sengled.cloud.ui.view.ThButton
                android:gravity="center"
                android:id="@+id/bt_login"
                android:layout_marginRight="5dp"
                android:text="@string/login_btn"
                android:layout_weight="1"
                style="@style/ActivityBtn"/>
            <com.sengled.cloud.ui.view.ThButton
                android:gravity="center"
                android:id="@+id/bt_regist"
                android:layout_marginLeft="5dp"
                android:text="@string/bt_regist"
                android:layout_weight="1"
                style="@style/ActivityBtn"/>
        </LinearLayout>
        <com.sengled.cloud.ui.view.ThButton
            android:textSize="@dimen/small_text_size"
            android:textColor="@color/text_plain_gray_deep"
            android:layout_gravity="right"
            android:id="@+id/bt_forget_pwd"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:text="@string/bt_forget_pwd"/>
    </LinearLayout>
</LinearLayout>
