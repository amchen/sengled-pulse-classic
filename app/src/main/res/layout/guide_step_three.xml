<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:guide="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/arr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/guide_arr1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/arr">
            <com.sengled.stspeaker.widget.GuideContentTextView
                android:textSize="@dimen/guide_nomal"
                android:id="@+id/content"
                android:paddingTop="@dimen/guide_three_content_top"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/three_content"
                android:lineSpacingExtra="@dimen/guide_space_extra"
                android:rotation="-8"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/guide_three_top"
                android:layout_below="@+id/arr">
                <ImageView
                    android:id="@+id/guid_three_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/guide_icon3"/>
                <com.sengled.stspeaker.widget.SkipView
                    android:id="@+id/guide_three_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    guide:guideType="skip"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
