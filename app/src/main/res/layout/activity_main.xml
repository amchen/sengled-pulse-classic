<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/product_logo"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_circle_outer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/load_icon"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/iv_circle_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/load_icon2"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="@dimen/tab_text_size"
            android:textColor="@color/text_red"
            android:layout_gravity="center_horizontal"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/search"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.stspeaker.widget.ThTextView
            android:textColor="@color/text_deep"
            android:gravity="center"
            android:id="@+id/tv_made"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.sengled.stspeaker.widget.ThTextView
            android:textSize="10sp"
            android:textColor="@color/mgray2"
            android:gravity="center"
            android:id="@+id/textView1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Sengled Speaker …."/>
    </LinearLayout>
</LinearLayout>
