<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:guide="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/guide_five_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:src="@drawable/guide_icon5"/>
    <com.sengled.stspeaker.widget.GuideContentTextView
        android:textSize="@dimen/guide_nomal"
        android:id="@+id/tv"
        android:paddingBottom="25dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/five_content"
        android:layout_toRightOf="@+id/guide_five_img"
        android:layout_alignTop="@+id/guide_five_img"
        android:lineSpacingExtra="@dimen/guide_space_extra"
        android:rotation="-8"/>
    <com.sengled.stspeaker.widget.SkipView
        android:id="@+id/guide_five_ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignRight="@+id/tv"
        android:layout_alignBottom="@+id/tv"
        guide:guideType="ok"/>
</RelativeLayout>
