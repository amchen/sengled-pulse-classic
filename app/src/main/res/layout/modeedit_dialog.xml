<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:id="@+id/top_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="#737373"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:text="@string/modedialog_speed"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ea2839"
                android:id="@+id/mode_default"
                android:background="@drawable/shape_conrner_default"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                android:text="@string/modedialog_default"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="40dp"
            android:layout_below="@+id/top_line">
            <TextView
                android:textSize="18sp"
                android:textColor="#737373"
                android:id="@+id/text_slow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modedialog_slow"/>
            <SeekBar
                android:layout_gravity="center"
                android:id="@+id/speek_control"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:maxHeight="6dp"
                android:progressDrawable="@drawable/rgb_brightseek"
                android:minHeight="6dp"
                android:thumb="@mipmap/thumb_rgb"
                android:layout_weight="1"
                android:layout_toRightOf="@+id/text_slow"
                android:layout_centerHorizontal="true"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#737373"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modedialog_high"
                android:layout_toRightOf="@+id/speek_control"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
