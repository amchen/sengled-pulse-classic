<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_gray"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/load_more_view"
        android:background="@drawable/cloud_load_more_selector"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="80dp">
        <com.sengled.cloud.ui.view.ThTextView
            android:textSize="@dimen/content_size"
            android:textColor="@color/text_plain_gray_deep"
            android:gravity="center"
            android:id="@+id/load_more_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/list_view_more"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/loading_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                style="?android:attr/progressBarStyleSmall"/>
            <com.sengled.cloud.ui.view.ThTextView
                android:textSize="18sp"
                android:textColor="@color/text_plain_gray_deep"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/list_loding"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
